# ZeroDev Dashboard -> Create Project (Polygon Amoy) -> Project ID
EXPO_PUBLIC_ZERODEV_PROJECT_ID=

# Web3Auth Dashboard -> Plug and Play -> Project -> Client ID (allow redirect URI: remitchain://auth)
EXPO_PUBLIC_WEB3AUTH_CLIENT_ID=

# Web3Auth Dashboard -> Authentication -> Social Connections -> Google Verifier / Connection ID
EXPO_PUBLIC_WEB3AUTH_CONNECTION_ID=

# Web3Auth network environment (sapphire_devnet for testnet, sapphire_mainnet for production)
EXPO_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# Optional (for real Google Drive wallet backup): Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (iOS/Native)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Alchemy Dashboard -> Apps -> Polygon Amoy -> Networks -> HTTPS URL
EXPO_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology/

# Pinata Dashboard -> Gateways -> copy your dedicated gateway URL (e.g. https://your-name.mypinata.cloud)
EXPO_PUBLIC_PINATA_GATEWAY=

# Your Next.js backend URL (use http://10.0.2.2:3000 on Android emulator, or your Vercel URL)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: Sentry Dashboard -> Project Settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Output from `forge script script/DeployAll.s.sol --broadcast` (MockUSDC or Amoy USDC 0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582)
EXPO_PUBLIC_USDC_ADDRESS=

# Output from `forge script script/DeployAll.s.sol --broadcast` (BoothRegistry deployed address)
EXPO_PUBLIC_BOOTH_REGISTRY_ADDRESS=

# Output from `forge script script/DeployAll.s.sol --broadcast` (YieldVault deployed address)
EXPO_PUBLIC_YIELD_VAULT_ADDRESS=

# Output from `forge script script/DeployAll.s.sol --broadcast` (RemittanceEscrow deployed address)
EXPO_PUBLIC_REMITTANCE_ESCROW_ADDRESS=
